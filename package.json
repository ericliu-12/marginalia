{
  "name": "marginalia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "dev:seed-library": "tsx --env-file-if-exists=.env src/dev-seed-library.ts",
    "connections:backfill": "tsx --env-file-if-exists=.env src/backfill-connections.ts",
    "embed:backfill": "tsx --env-file-if-exists=.env src/backfill-embeddings.ts",
    "graph:layout": "tsx --env-file-if-exists=.env src/layout-graph.ts",
    "invite": "tsx --env-file-if-exists=.env src/invite.ts",
    "eval": "tsx --env-file-if-exists=.env scripts/eval/judge-eval.ts",
    "bench:graph": "tsx --env-file-if-exists=.env scripts/bench/graph-bench.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:deploy": "pnpm db:migrate",
    "ticket": "bash scripts/ticket.sh",
    "ticket:done": "bash scripts/ticket-done.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "force-graph": "^1.52.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout-forceatlas2": "^0.10.1",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "pg-boss": "^12.35.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "graphology-types": "^0.24.8",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
