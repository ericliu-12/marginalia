# Matches docker-compose.yml
DATABASE_URL=postgres://marginalia:marginalia@localhost:5433/marginalia
# Contact email sent in the Open Library User-Agent (raises the rate limit to 3 req/s)
OPEN_LIBRARY_CONTACT=you@example.com
# Google Books API key for add-time descriptions (optional; Books are added without one)
GOOGLE_BOOKS_API_KEY=
# Claude API key for Enrichment (used by the worker)
ANTHROPIC_API_KEY=
# Voyage AI API key for Enrichment and Note embeddings (used by the worker)
VOYAGE_API_KEY=
