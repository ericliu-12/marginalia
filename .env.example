# Matches docker-compose.yml
DATABASE_URL=postgres://marginalia:marginalia@localhost:5433/marginalia
# Contact email sent in the Open Library User-Agent (raises the rate limit to 3 req/s)
OPEN_LIBRARY_CONTACT=you@example.com
# Google Books API key for add-time descriptions (optional; Books are added without one)
GOOGLE_BOOKS_API_KEY=
# Claude API key for Enrichment (used by the worker)
ANTHROPIC_API_KEY=
# Voyage AI API key for Enrichment and Note embeddings (used by the worker)
VOYAGE_API_KEY=
# Sign-in (Better Auth). Production sets BETTER_AUTH_URL=https://inkmarginalia.com; every absolute URL and
# redirect is built from it. Unset in development, it is http://localhost:3000.
BETTER_AUTH_URL=
# At least 32 random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Sends sign-in codes. Unset in development, codes are printed to the dev server's console.
RESEND_API_KEY=
# allowlist (the default: only `pnpm invite`d emails and existing Readers sign in) or open
SIGNUP_MODE=
# The owner's real email: `pnpm db:seed` moves the seeded reader to it, once.
OWNER_EMAIL=
# Google sign-in (the #59 spike now, Better Auth with #63)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cloudflare Turnstile (the #59 spike's page)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
